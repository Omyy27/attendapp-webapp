# Requerido
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Requerido para equipo (API team) y despacho por email
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opcional: notificaciones push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Opcional: envío de email con Resend
RESEND_API_KEY=
RESEND_FROM=Tu Nombre <invitaciones@tu-dominio.com>

# Mapa y búsqueda de direcciones (Mapbox). Usa un token PÚBLICO (pk.…) y restríngelo por URL.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.tu-token-publico
